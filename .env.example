# Copy to .env and fill in. Never commit .env.
# Twitch chat bot identity (create an app at https://dev.twitch.tv/console/apps
# and generate a chat OAuth token, e.g. via https://twitchtokengenerator.com).
TWITCH_BOT_USERNAME=
TWITCH_OAUTH_TOKEN=oauth:
TWITCH_CHANNEL=
# Port for the overlay + streamer panel web server.
PORT=3000
